generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SignalDirection {
  BUY
  SELL
}

enum SignalStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  ACTIVE
  TP1_HIT
  TP2_HIT
  CLOSED_TP
  CLOSED_SL
  CLOSED_MANUAL
  CANCELLED
  EXPIRED
}

enum SignalRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SignalTimeframe {
  M15
  M30
  H1
  H4
  D1
}

enum SignalTimeframeRole {
  CONTEXT
  STRUCTURE
  ENTRY
  CONFIRMATION
}

enum MarketSession {
  ASIA
  LONDON
  NEW_YORK
  LONDON_NY_OVERLAP
  GLOBAL
}

enum QualityLabel {
  STRONG_SETUP
  VALID_SETUP
  WEAK_SETUP
  NO_TRADE
}

enum SignalResultOutcome {
  OPEN
  WIN
  LOSS
  BREAKEVEN
  CANCELLED
}

enum SignalSource {
  MANUAL
  ENGINE
  HYBRID
}

enum EngineRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum EngineCandidateStatus {
  REJECTED
  PENDING_REVIEW
  APPROVED
  DISCARDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum ContentPostType {
  EDUCATION
  ANNOUNCEMENT
  MARKET_COMMENTARY
  RISK_MESSAGE
}

enum ContentPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  ALL
}

enum AccessTier {
  FREE
  PREMIUM
}

// ---------- USERS & AUTH ----------

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  emailVerified       DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  profile                Profile?
  accounts               Account[]
  sessions               Session[]
  notifications          Notification[]
  notificationPreference UserNotificationPreference?
  pushSubscriptions      PushSubscription[]
  subscriptions          Subscription[]

  createdSignals  Signal[]       @relation("SignalCreatedBy")
  approvedSignals Signal[]       @relation("SignalApprovedBy")
  signalUpdates   SignalUpdate[] @relation("SignalUpdateCreatedBy")

  auditLogs    AdminAuditLog[] @relation("AdminAuditLogs")
  contentPosts ContentPost[]   @relation("ContentAuthor")

  updatedSystemSettings SystemSetting[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  userId                String    @id
  displayName           String?
  avatarUrl             String?
  timezone              String    @default("UTC")
  baseCurrency          String    @default("USD") @db.Char(3)
  defaultAccountBalance Decimal?  @db.Decimal(18, 2)
  defaultRiskPercent    Decimal   @default(1.0) @db.Decimal(5, 2)
  onboardedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ---------- MARKET ----------

model Symbol {
  id            Int      @id @default(autoincrement())
  symbol        String   @unique
  displayName   String
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  pipSize       Decimal  @db.Decimal(10, 5)
  priceDecimals Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  signals          Signal[]
  marketAnalyses   MarketAnalysis[]
  engineCandidates SignalEngineCandidate[]

  @@map("symbols")
}

// ---------- SIGNALS ----------

model Signal {
  id            String          @id @default(cuid())
  signalCode    String          @unique
  symbolId      Int
  direction     SignalDirection
  timeframe     SignalTimeframe
  marketSession MarketSession?
  status        SignalStatus    @default(DRAFT)

  entryPrice    Decimal  @db.Decimal(18, 8)
  stopLossPrice Decimal  @db.Decimal(18, 8)
  tp1Price      Decimal  @db.Decimal(18, 8)
  tp2Price      Decimal? @db.Decimal(18, 8)
  tp3Price      Decimal? @db.Decimal(18, 8)

  riskPips   Decimal? @db.Decimal(18, 2)
  rewardPips Decimal? @db.Decimal(18, 2)
  riskReward Decimal? @db.Decimal(8, 3)
  riskLevel  SignalRiskLevel @default(MEDIUM)
  accessTier AccessTier @default(PREMIUM)
  
  qualityScore Int?
  qualityLabel QualityLabel?

  analysisMd  String?
  reasoningMd String?

  source      SignalSource @default(MANUAL)
  engineRunId String?

  createdById  String?
  approvedById String?

  publishedAt DateTime?
  activatedAt DateTime?
  expiresAt   DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbol          Symbol                   @relation(fields: [symbolId], references: [id])
  timeframes      SignalTimeframeUsage[]
  factors         SignalFactor[]
  updates         SignalUpdate[]
  result          SignalResult?
  notifications   Notification[]
  engineCandidate SignalEngineCandidate?

  createdBy  User?            @relation("SignalCreatedBy", fields: [createdById], references: [id])
  approvedBy User?            @relation("SignalApprovedBy", fields: [approvedById], references: [id])
  engineRun  SignalEngineRun? @relation(fields: [engineRunId], references: [id])

  @@index([status, publishedAt])
  @@index([symbolId, publishedAt])
  @@index([createdAt])
  @@map("signals")
}

model SignalTimeframeUsage {
  id        String              @id @default(cuid())
  signalId  String
  timeframe SignalTimeframe
  role      SignalTimeframeRole
  note      String?
  createdAt DateTime            @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId, timeframe, role])
  @@index([signalId])
  @@map("signal_timeframes")
}

model SignalFactor {
  id        String   @id @default(cuid())
  signalId  String
  factor    String
  score     Int
  maxScore  Int
  note      String?
  createdAt DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId, factor])
  @@index([signalId])
  @@map("signal_factors")
}

model SignalUpdate {
  id          String        @id @default(cuid())
  signalId    String
  oldStatus   SignalStatus?
  newStatus   SignalStatus
  price       Decimal?      @db.Decimal(18, 8)
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  signal    Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("SignalUpdateCreatedBy", fields: [createdById], references: [id])

  @@index([signalId, createdAt])
  @@map("signal_updates")
}

model SignalResult {
  signalId       String              @id
  outcome        SignalResultOutcome @default(OPEN)
  realizedR      Decimal?            @db.Decimal(10, 3)
  realizedPips   Decimal?            @db.Decimal(18, 2)
  tpLevelReached Int?
  note           String?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("signal_results")
}

// ---------- SIGNAL ENGINE ----------

model MarketAnalysis {
  id               String            @id @default(cuid())
  symbolId         Int
  timeframe        SignalTimeframe
  runAt            DateTime
  closePrice       Decimal?          @db.Decimal(18, 8)
  ema50            Decimal?          @db.Decimal(18, 8)
  ema200           Decimal?          @db.Decimal(18, 8)
  rsi14            Decimal?          @db.Decimal(8, 4)
  macd             Json?
  atr14            Decimal?          @db.Decimal(18, 8)
  marketStructure  String?
  supportLevels    Json?
  resistanceLevels Json?
  liquidityZones   Json?
  orderBlocks      Json?
  fairValueGaps    Json?
  notes            String?
  raw              Json?
  createdAt        DateTime          @default(now())

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, timeframe, runAt])
  @@map("market_analysis")
}

model SignalEngineRun {
  id              String          @id @default(cuid())
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  status          EngineRunStatus
  provider        String?
  params          Json?
  candidatesCount Int             @default(0)
  noTradeCount    Int             @default(0)
  publishedCount  Int             @default(0)
  error           String?
  createdAt       DateTime        @default(now())

  candidates SignalEngineCandidate[]
  signals    Signal[]

  @@map("signal_engine_runs")
}

model SignalEngineCandidate {
  id               String                @id @default(cuid())
  engineRunId      String
  symbolId         Int
  timeframe        SignalTimeframe
  direction        SignalDirection
  entryPrice       Decimal?              @db.Decimal(18, 8)
  stopLossPrice    Decimal?              @db.Decimal(18, 8)
  tp1Price         Decimal?              @db.Decimal(18, 8)
  tp2Price         Decimal?              @db.Decimal(18, 8)
  tp3Price         Decimal?              @db.Decimal(18, 8)
  qualityScore     Int
  qualityLabel     QualityLabel
  factors          Json?
  rejectionReasons Json?
  status           EngineCandidateStatus @default(REJECTED)
  signalId         String?               @unique
  createdAt        DateTime              @default(now())

  engineRun SignalEngineRun @relation(fields: [engineRunId], references: [id], onDelete: Cascade)
  symbol    Symbol          @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  signal    Signal?         @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([engineRunId])
  @@index([symbolId, createdAt])
  @@map("signal_engine_candidates")
}

// ---------- NOTIFICATIONS ----------

model Notification {
  id        String              @id @default(cuid())
  userId    String
  eventType String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  signalId  String?
  data      Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([signalId])
  @@map("notifications")
}

model UserNotificationPreference {
  userId            String   @id
  inAppNewSignal    Boolean  @default(true)
  inAppSignalStatus Boolean  @default(true)
  emailNewSignal    Boolean  @default(false)
  emailSignalStatus Boolean  @default(false)
  pushNewSignal     Boolean  @default(false)
  pushSignalStatus  Boolean  @default(false)
  weeklyReport      Boolean  @default(true)
  quietHoursStart   String?
  quietHoursEnd     String?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------- ADMIN & CONTENT ----------

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser User @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

model ContentPost {
  id          String            @id @default(cuid())
  slug        String            @unique
  type        ContentPostType
  title       String
  excerpt     String?
  bodyMd      String
  authorId    String?
  status      ContentPostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  author User? @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([type])
  @@map("content_posts")
}

// ---------- ANALYTICS & SETTINGS ----------

model PerformanceMetric {
  id            String     @id @default(cuid())
  period        PeriodType
  periodStart   DateTime   @db.Date
  periodEnd     DateTime   @db.Date
  totalSignals  Int        @default(0)
  closedSignals Int        @default(0)
  wins          Int        @default(0)
  losses        Int        @default(0)
  breakevens    Int        @default(0)
  cancelled     Int        @default(0)
  winRate       Decimal?   @db.Decimal(6, 3)
  avgRr         Decimal?   @db.Decimal(8, 3)
  totalR        Decimal?   @db.Decimal(12, 3)
  profitFactor  Decimal?   @db.Decimal(12, 3)
  maxDrawdownR  Decimal?   @db.Decimal(12, 3)
  avgWinR       Decimal?   @db.Decimal(12, 3)
  avgLossR      Decimal?   @db.Decimal(12, 3)
  computedAt    DateTime   @default(now())

  @@unique([period, periodStart])
  @@map("performance_metrics")
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  plan                   String
  status                 String
  provider               String?
  providerSubscriptionId String?
  currentPeriodEndsAt    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubscriptionId])
  @@index([userId])
  @@map("subscriptions")
}